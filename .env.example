# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Settings can also come from real environment variables, which take precedence.
#
# Several Tenable targets (for example five ICPs and no Enterprise Manager)?
# Leave the Tenable section below empty and use a config file instead:
#   cp targets.example.ini targets.ini     # then:  --config targets.ini

# ==== Tenable OT Security (one target) =======================================
# Base URL only: no trailing slash, no /graphql, no site id. Works for both an
# Enterprise Manager and a standalone ICP; the tool detects which it is.
TENABLE_URL=
# The single API key generated in the OT Security console (sent as
# `X-APIKeys: key=<this value>`). This is NOT a Tenable One cloud
# accessKey/secretKey pair. The key's user needs permission to read assets.
# There is deliberately no command-line option for the key (it would end up in
# shell history and the process list).
TENABLE_API_KEY=

# Enterprise Manager only: the site to use, by NAME (the id is looked up for you).
# Use `all` for every paired site. If exactly one site is paired it is used
# automatically. Same as `--site NAME`. Ignored for a standalone ICP.
TENABLE_SITE=
# Normally leave unset. Force `em` or `icp` if detection ever guesses wrong.
# TENABLE_MODE=auto

# Asset columns to export (default: all). A comma-separated list, or `all`
# for every Tenable OT Inventory-view column. Run `python t1ote_export_assets.py columns` to see
# the names. --export-columns / --export-all-columns on the command line override this.
# The Power BI dataset must be created with the same list (see README, "Choosing columns").
# TENABLE_EXPORT_COLUMNS=name,vendor,model,ips,last_seen

# TLS to Tenable. Prefer a CA bundle for a private/internal CA:
TENABLE_CA_BUNDLE=
# ...or set to 0 to skip certificate verification (lab/evaluation use only):
TENABLE_TLS_VERIFY=1

# ==== NVD (National Vulnerability Database) ==================================
# Optional but strongly recommended. A free key (request one at
# https://nvd.nist.gov/developers/request-an-api-key) raises the limit from
# ~5 to ~50 requests per 30 s; this tool waits ~6.5 s between requests without
# a key and ~0.7 s with one.
NVD_API_KEY=

# ==== Power BI (optional; for `--powerbi` on `assets`, `sbom` and `run`) ====
# Microsoft Entra app registration (public client flows allowed) and workspace.
# Run `python t1ote_export_assets.py login` once to sign in.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Workspace GUID; leave empty for "My workspace". Both tools use the same workspace.
POWERBI_WORKSPACE_ID=
# ONE dataset holds all three tables: assets, sbom_software, sbom_findings.
# Run `python t1ote_export_assets.py create-dataset` once and paste the id it prints.
# Both `assets --powerbi` (fills `assets`) and `sbom --powerbi`
# (fills the two SBOM tables) write to this dataset.
POWERBI_DATASET_ID=
# Optional names (defaults shown). Set these BEFORE create-dataset:
# POWERBI_DATASET_NAME=Tenable OT Assets and SBOM
# POWERBI_TABLE_NAME=assets
# Where the Microsoft sign-in refresh token is stored (a credential; the
# default name is already git-ignored):
# TOKEN_CACHE_FILE=.powerbi_token.json

# CycloneDX identity (optional; or use --sbom-author, --product-name, --product-version)
# SBOM_AUTHOR=Your Name <you@example.com>
# SBOM_PRODUCT_NAME=
# SBOM_PRODUCT_VERSION=

# Vendor list for supplier names (default: vendors.tsv next to the script; "none" disables)
# TENABLE_VENDOR_FILE=
